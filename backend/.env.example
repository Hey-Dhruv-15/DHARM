# DHARM Backend Environment Variables Template
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/dharm

# Security & JWT Auth
SECRET_KEY=replace-with-your-strong-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS Settings (frontend origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
